# Môi trường LOCAL (tuỳ chọn). Chạy: TEST_ENV=local .venv/bin/python -m pytest
# ===== URL =====
# Frontend (Vite dev server chạy cổng 3000)
BASE_URL=http://localhost:3000
# Backend Express (cổng 5000)
API_URL=http://localhost:5000/api

# ===== Tự khởi động server khi chạy test =====
# 1 = framework (tests/conftest.py) tự chạy `npm run dev` cho backend + frontend (nếu chưa chạy)
START_SERVERS=0
# Thư mục gốc của dự án web (chứa frontend/ và backend/)
APP_DIR=/Users/ccm/Documents/Dự án cá nhân/Web bán quần áo/Đồ án Quần áo

# ===== Cho phép test GHI dữ liệu thật vào DB =====
# CẢNH BÁO: backend local đang dùng chung DB Supabase với production.
# 0 = chỉ đọc + mock các API ghi (tạo đơn, đăng ký). 1 = tạo user/đơn hàng thật.
E2E_ALLOW_WRITE=0

# ===== Tài khoản test =====
# Khách hàng: nếu để trống và E2E_ALLOW_WRITE=1, setup sẽ tự đăng ký 1 tài khoản mới.
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
# Admin: để trống thì các test admin cần đăng nhập sẽ bị skip.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
