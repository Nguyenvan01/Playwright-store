{
  "name": "cloth-store-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ test tự động Playwright cho website bán quần áo Đạt Hoàng",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "test:prod": "TEST_ENV=prod playwright test",
    "test:prod:smoke": "TEST_ENV=prod playwright test --grep @smoke",
    "test:prod:api": "TEST_ENV=prod playwright test --project=api",
    "report": "playwright show-report reports/local/html",
    "report:prod": "playwright show-report reports/prod/html",
    "codegen": "playwright codegen http://localhost:3000",
    "codegen:prod": "playwright codegen https://dat-hoang-store.vercel.app",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install chromium",
    "test:keyword": "playwright test tests/e2e/keyword-driven",
    "test:prod:keyword": "TEST_ENV=prod playwright test tests/e2e/keyword-driven",
    "docs:keywords": "node scripts/gen-keywords-doc.mjs",
    "test:prod:headed": "TEST_ENV=prod playwright test --project=chromium --headed --workers=1",
    "test:prod:ui": "TEST_ENV=prod playwright test --ui",
    "test:prod:debug": "TEST_ENV=prod playwright test --project=chromium --debug",
    "test:prod:watch": "TEST_ENV=prod SLOW_MO=600 playwright test --project=chromium --headed --workers=1 --retries=0",
    "docs:testcases": "node scripts/gen-test-cases.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "dotenv": "^18.0.5",
    "typescript": "^7.0.2"
  }
}
