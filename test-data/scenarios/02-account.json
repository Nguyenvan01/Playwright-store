[
  {
    "id": "KD-ACC-01",
    "title": "Đăng nhập, xem đơn hàng, đăng xuất",
    "tags": ["@smoke"],
    "requires": ["customer"],
    "steps": [
      { "keyword": "auth.openLogin" },
      { "keyword": "auth.login", "args": ["${env.customer.email}", "${env.customer.password}"] },
      { "keyword": "common.verifyUrl", "arg": "/profile" },
      { "keyword": "auth.verifyLoggedInAs", "arg": "${env.customer.email}" },
      { "keyword": "account.openAccountMenuLink", "arg": "Đơn hàng của tôi" },
      { "keyword": "common.verifyUrl", "arg": "/orders" },
      { "keyword": "account.verifyOrdersLoaded" },
      { "keyword": "auth.logout" },
      { "keyword": "auth.verifyLoggedOut" }
    ]
  },
  {
    "id": "KD-ACC-02",
    "title": "Khôi phục phiên qua API rồi vào trang Yêu thích",
    "requires": ["customer"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "customer" },
      { "keyword": "catalog.openHome" },
      { "keyword": "account.openAccountMenuLink", "arg": "Yêu thích" },
      { "keyword": "common.verifyUrl", "arg": "/favorites" },
      { "keyword": "account.verifyWishlistLoaded" }
    ]
  },
  {
    "id": "KD-ACC-03",
    "title": "Đăng nhập sai mật khẩu hiển thị lỗi",
    "knownBug": "Interceptor 401 trong services/api.js reload sang /login nên thông báo lỗi bị mất",
    "steps": [
      { "keyword": "auth.openLogin" },
      {
        "keyword": "auth.loginExpectingError",
        "args": ["khong-ton-tai-e2e@example.com", "sai-mat-khau", "Email hoặc mật khẩu không đúng"]
      }
    ]
  },
  {
    "id": "KD-ACC-04",
    "title": "Đăng ký: validate form trống",
    "steps": [
      { "keyword": "auth.openLogin" },
      { "keyword": "auth.openRegisterForm" },
      { "keyword": "auth.submitRegisterForm", "arg": { "name": "", "email": "", "phone": "", "password": "" } },
      {
        "keyword": "auth.verifyFieldErrors",
        "arg": ["Vui lòng nhập họ và tên", "Vui lòng nhập số điện thoại", "Vui lòng nhập mật khẩu"]
      }
    ]
  }
]
