[
  {
    "id": "KD-ADS-01",
    "title": "Dashboard hiển thị số liệu (mock) và đi tới Đơn hàng",
    "tags": ["@smoke"],
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "common.mockGet", "args": ["**/api/admin/dashboard", "@data:admin-sales/dashboard.json#response"] },
      { "keyword": "adminSales.mockOrdersApi", "arg": "@data:admin-sales/orders.json#fixture" },
      { "keyword": "admin.openAdminPage", "args": ["/admin", "Tổng quan"] },
      { "keyword": "adminSales.verifyStatCards", "arg": "@data:admin-sales/dashboard.json#expected.cards" },
      { "keyword": "adminSales.verifyRecentOrders", "arg": "@data:admin-sales/dashboard.json#expected.recentOrders" },
      { "keyword": "adminSales.clickDashboardLink", "args": ["Xem tất cả", "Đơn hàng gần đây"] },
      { "keyword": "common.verifyUrl", "arg": "/admin/orders" },
      { "keyword": "adminSales.verifyOrderStatusCards", "arg": "@data:admin-sales/orders.json#statusCards" }
    ]
  },
  {
    "id": "KD-ADS-02",
    "title": "Xác nhận đơn hàng chờ xử lý (mock GET + PUT)",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminSales.mockOrdersApi", "arg": "@data:admin-sales/orders.json#fixture" },
      { "keyword": "common.mockWrite", "args": ["PUT", "**/api/admin/orders/9001/status", { "success": true, "status": "confirmed" }] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/orders", "Đơn hàng"] },
      { "keyword": "adminSales.clickOrderStatusCard", "arg": "Chờ xác nhận" },
      { "keyword": "adminSales.verifyOrderRows", "arg": ["E2E-0001", "E2E-0008"] },
      { "keyword": "adminSales.openOrderDetail", "arg": "E2E-0001" },
      { "keyword": "adminSales.verifyOrderStatusButtons", "arg": ["Xác nhận", "Hủy đơn"] },
      { "keyword": "adminSales.clickOrderStatusButton", "arg": "Xác nhận" },
      { "keyword": "common.verifyRequest", "args": ["PUT", "/admin/orders/9001/status", { "status": "confirmed" }] },
      { "keyword": "common.verifyToast", "arg": "Đã cập nhật trạng thái: Đã xác nhận" },
      { "keyword": "adminSales.verifyOrderDetailStatus", "arg": "Đã xác nhận" }
    ]
  },
  {
    "id": "KD-ADS-03",
    "title": "Thêm khách hàng: lỗi validate rồi sửa và lưu (mock POST)",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminSales.mockCustomersApi", "arg": "@data:admin-sales/customers.json#fixture" },
      { "keyword": "common.mockWrite", "args": ["POST", "**/api/admin/customers", "@data:admin-sales/customers.json#add.response"] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/customers", "Khách hàng"] },
      { "keyword": "admin.clickButton", "arg": "Thêm khách hàng" },
      { "keyword": "admin.fillForm", "arg": { "Họ và tên": "Khách Hàng Mới E2E", "Email": "sai-email" } },
      { "keyword": "admin.clickButton", "arg": "Lưu" },
      { "keyword": "adminSales.verifyFieldErrors", "args": ["Thêm khách hàng", ["Email không đúng định dạng."]] },
      { "keyword": "common.verifyNoRequest", "args": ["POST", "/admin/customers"] },
      { "keyword": "admin.fillForm", "arg": "@data:admin-sales/customers.json#add.form" },
      { "keyword": "admin.clickButton", "arg": "Lưu" },
      { "keyword": "common.verifyRequest", "args": ["POST", "/admin/customers", "@data:admin-sales/customers.json#add.payload"] },
      { "keyword": "common.verifyToast", "arg": "Thêm khách hàng thành công." },
      { "keyword": "adminSales.verifyPersonRow", "arg": "Khách Hàng Mới E2E" }
    ]
  },
  {
    "id": "KD-ADS-04",
    "title": "Mở chuông thông báo (mock) và đi tới trang đánh giá",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "common.mockGet", "args": ["**/api/admin/notifications", "@data:admin-sales/layout.json#notifications.some"] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/customers", "Khách hàng"] },
      { "keyword": "adminSales.openNotifications" },
      { "keyword": "adminSales.verifyNotificationPanel", "arg": "@data:admin-sales/layout.json#notifications.panel" },
      { "keyword": "adminSales.clickNotification", "arg": "Đánh giá chờ duyệt" },
      { "keyword": "common.verifyUrl", "arg": "/admin/reviews" },
      { "keyword": "adminSales.verifyActiveMenu", "arg": "Đánh giá" }
    ]
  },
  {
    "id": "KD-ADS-05",
    "title": "Sửa vai trò nhân viên (mock PUT) rồi gạt tắt tài khoản (mock PUT)",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminSales.mockEmployeesApi", "arg": "@data:admin-sales/employees.json#fixture" },
      { "keyword": "common.mockWrite", "args": ["PUT", "**/api/admin/employees/9101", "@data:admin-sales/employees.json#edit.response"] },
      { "keyword": "common.mockWrite", "args": ["PUT", "**/api/admin/employees/9101/toggle", { "success": true }] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/employees", "Nhân viên"] },
      { "keyword": "adminSales.clickEmployeeAction", "args": ["Nhân Viên E2E", "Sửa"] },
      { "keyword": "admin.fillForm", "arg": "@data:admin-sales/employees.json#edit.form" },
      { "keyword": "admin.clickButton", "arg": "Lưu" },
      { "keyword": "common.verifyRequest", "args": ["PUT", "/admin/employees/9101", "@data:admin-sales/employees.json#edit.payload"] },
      { "keyword": "common.verifyToast", "arg": "Đã cập nhật nhân viên" },
      { "keyword": "adminSales.verifyEmployeeRole", "args": ["Nhân Viên Đã Sửa E2E", "Quản lý"] },
      { "keyword": "adminSales.clickEmployeeAction", "args": ["Nhân Viên Đã Sửa E2E", "Trạng thái"] },
      { "keyword": "common.verifyRequest", "args": ["PUT", "/admin/employees/9101/toggle"] },
      { "keyword": "adminSales.verifyEmployeeActive", "args": ["Nhân Viên Đã Sửa E2E", false] }
    ]
  }
]
