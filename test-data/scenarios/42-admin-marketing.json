[
  {
    "id": "KD-ADM2-01",
    "title": "Khuyến mãi: tìm không dấu và kiểm tra trạng thái tính theo ngày",
    "tags": ["@smoke"],
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminMarketing.mockPromotionList", "arg": "@data:admin-marketing/promotions.json#list" },
      { "keyword": "adminMarketing.openPromotions" },
      { "keyword": "adminMarketing.verifyColumns", "arg": "@data:admin-marketing/promotions.json#headers" },
      { "keyword": "adminMarketing.verifyRowCells", "args": ["Giảm giá Tết", { "Trạng thái": "Hết hạn", "Giá trị": "15%" }] },
      { "keyword": "admin.searchList", "args": ["Tìm theo tên, mô tả hoặc trạng thái", "uu dai"] },
      { "keyword": "adminMarketing.verifyVisibleRows", "args": [["Ưu đãi cuối tuần"], ["Flash Sale mùa hè", "Giảm giá Tết"]] },
      { "keyword": "common.verifyNoPageErrors" }
    ]
  },
  {
    "id": "KD-ADM2-02",
    "title": "Khuyến mãi: thêm mới gửi đúng dữ liệu (mock POST)",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "common.mockWrite", "args": ["POST", "**/api/admin/promotions", { "success": true }] },
      { "keyword": "adminMarketing.mockPromotionList", "arg": "@data:admin-marketing/promotions.json#list" },
      { "keyword": "adminMarketing.openPromotions" },
      { "keyword": "adminMarketing.openCreatePromotion" },
      { "keyword": "admin.fillForm", "arg": "@data:admin-marketing/promotions.json#create.form" },
      { "keyword": "adminMarketing.clickModalButton", "args": ["Thêm khuyến mãi", "Tạo mới"] },
      { "keyword": "common.verifyRequest", "args": ["POST", "/admin/promotions", "@data:admin-marketing/promotions.json#create.expectedPayload"] },
      { "keyword": "common.verifyToast", "arg": "Thêm khuyến mãi thành công." }
    ]
  },
  {
    "id": "KD-ADM2-03",
    "title": "Mã giảm giá: tắt Công khai rồi xóa mã (mock PUT/DELETE)",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "common.mockWrite", "args": ["PUT", "**/api/admin/coupons/*", { "success": true }] },
      { "keyword": "common.mockWrite", "args": ["DELETE", "**/api/admin/coupons/*", { "success": true }] },
      { "keyword": "adminMarketing.mockCouponList", "arg": "@data:admin-marketing/coupons.json#list" },
      { "keyword": "adminMarketing.openCoupons" },
      { "keyword": "adminMarketing.toggleCoupon", "args": ["HETHAN1", "Công khai"] },
      { "keyword": "common.verifyRequest", "args": ["PUT", "/admin/coupons/1", { "is_public": false }] },
      { "keyword": "adminMarketing.verifyCouponToggle", "args": ["HETHAN1", "Công khai", false] },
      { "keyword": "adminMarketing.clickCouponDelete", "arg": "HETHAN1" },
      { "keyword": "adminMarketing.clickModalButton", "args": ["Xác nhận xóa", "Xóa"] },
      { "keyword": "common.verifyRequest", "args": ["DELETE", "/admin/coupons/1"] },
      { "keyword": "common.verifyToast", "arg": "Đã xóa mã giảm giá" },
      { "keyword": "admin.verifyRow", "args": ["HETHAN1", false] }
    ]
  },
  {
    "id": "KD-ADM2-04",
    "title": "Đánh giá: lọc chờ duyệt rồi duyệt 1 đánh giá (mock)",
