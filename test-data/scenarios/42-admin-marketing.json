    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "common.mockWrite", "args": ["PUT", "**/api/admin/reviews/*/status", { "success": true }] },
      { "keyword": "adminMarketing.mockReviewList", "arg": "@data:admin-marketing/reviews.json#list" },
      { "keyword": "adminMarketing.openReviews" },
      { "keyword": "adminMarketing.filterReviewStatus", "arg": "pending" },
      { "keyword": "adminMarketing.verifyListQuery", "args": ["/admin/reviews", { "status": "pending" }] },
      { "keyword": "adminMarketing.verifyRowCount", "arg": 2 },
      { "keyword": "admin.clickRowAction", "args": ["Nguyễn Văn An", "Duyệt"] },
      { "keyword": "common.verifyRequest", "args": ["PUT", "/admin/reviews/1/status", { "status": "approved" }] },
      { "keyword": "common.verifyToast", "arg": "Duyệt đánh giá thành công." },
      { "keyword": "adminMarketing.verifyRowActions", "args": ["Nguyễn Văn An", ["Xem", "Ẩn", "Xóa"]] }
    ]
  },
  {
