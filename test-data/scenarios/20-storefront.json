[
  {
    "id": "KD-SF-01",
    "title": "Trang Giảm giá: sắp xếp giá tăng dần rồi xem chi tiết sản phẩm đầu tiên",
    "tags": ["@smoke"],
    "steps": [
      { "keyword": "listing.openListing", "arg": "/giam-gia" },
      {
        "keyword": "listing.verifyListingHeader",
        "args": ["GIẢM GIÁ", "Khuyến mãi", "Ưu đãi lên đến 70% cho tất cả sản phẩm. Nhanh tay chọn ngay những item yêu thích với giá hời nhất!"]
      },
      { "keyword": "listing.verifyCountMatchesCards" },
      { "keyword": "listing.sortBy", "arg": "Giá: Thấp → Cao" },
      { "keyword": "listing.verifyPricesSorted", "arg": "asc" },
      { "keyword": "listing.viewFirstCardDetail" },
      { "keyword": "listing.verifyOpenedLastCard" },
      { "keyword": "common.verifyNoPageErrors" }
    ]
  },
  {
    "id": "KD-SF-02",
    "title": "Blog (mock): lọc danh mục, đọc bài, quay lại danh sách",
    "steps": [
      { "keyword": "content.mockBlogData", "arg": "@data:storefront/blog.json#mockList", "note": "không tăng lượt xem thật" },
      { "keyword": "content.openBlog" },
      { "keyword": "content.verifyBlogPills", "arg": ["Tất cả", "Xu hướng", "Phối đồ", "Thuật ngữ - Kiến thức"] },
      { "keyword": "content.filterBlogByCategory", "arg": "Phối đồ" },
      { "keyword": "content.verifyBlogCategoryOfCards", "arg": "Phối đồ" },
      { "keyword": "content.openBlogArticle", "arg": "Phối đồ E2E: chân váy dài" },
      { "keyword": "content.clickBackToBlog" },
      { "keyword": "common.verifyUrl", "arg": "/blog" }
    ]
  },
  {
    "id": "KD-SF-03",
    "title": "Chi tiết sản phẩm (mock): xem ảnh, đổi màu, mở accordion, khách chưa đăng nhập không đánh giá được",
    "steps": [
      { "keyword": "product.mockProductDetail", "args": ["e2e-ao-thun-kiem-thu", "@data:storefront/product.json#mockProduct"] },
      { "keyword": "product.openProductPage", "arg": "e2e-ao-thun-kiem-thu" },
      { "keyword": "product.verifyBreadcrumb", "arg": "Áo thun E2E kiểm thử" },
      { "keyword": "product.verifyGallery", "arg": 3 },
      { "keyword": "product.clickNextImage" },
      { "keyword": "product.verifyCurrentImage", "args": [2, 3] },
      { "keyword": "product.selectColor", "arg": "Xanh Navy" },
      { "keyword": "product.toggleAccordion", "arg": "Chất liệu" },
      { "keyword": "product.verifyOpenAccordion", "args": ["Chất liệu", ["Mô tả", "Chất liệu", "Hướng dẫn sử dụng"]] },
      { "keyword": "product.verifyReviewLoginPrompt" }
    ]
  },
  {
    "id": "KD-SF-04",
    "title": "Trang /search theo danh mục: chip lọc, bỏ chip, sắp xếp giá giảm dần",
    "steps": [
      { "keyword": "listing.openSearchResults", "arg": "?category=vay" },
      { "keyword": "listing.verifySearchTitle", "arg": "Vay" },
      { "keyword": "listing.verifySearchBreadcrumbs", "arg": ["Trang chủ", "Sản phẩm", "Vay"] },
      { "keyword": "listing.verifySearchChip", "args": ["Danh mục: Vay", "/search"] },
      { "keyword": "listing.closeSearchChip", "arg": "Danh mục: Vay" },
      { "keyword": "common.verifyUrl", "arg": "/search" },
      { "keyword": "listing.verifySearchTitle", "arg": "Tất cả sản phẩm" },
      { "keyword": "listing.sortSearchBy", "arg": "Giá: Cao → Thấp" },
      { "keyword": "listing.verifySearchPricesSorted", "arg": "desc" }
    ]
  },
  {
    "id": "KD-SF-05",
    "title": "Trang chủ (mock): chuyển banner, dùng mã voucher, đăng ký nhận tin",
    "steps": [
      { "keyword": "content.mockHomeData", "arg": "@data:storefront/home.json#mockHome" },
      { "keyword": "content.freezeClock", "note": "banner không tự chuyển slide giữa các bước" },
      { "keyword": "content.openHomePage" },
      { "keyword": "content.clickBannerDot", "arg": 2 },
      { "keyword": "content.verifyActiveBannerSlide", "arg": 2 },
      { "keyword": "content.verifyVoucher", "arg": "@data:storefront/home.json#vouchers.0" },
      { "keyword": "content.useVoucher", "arg": "Voucher E2E 50K" },
      { "keyword": "common.verifyUrl", "arg": "/nam" },
      { "keyword": "content.verifyPendingVoucher", "arg": "E2E50K" },
      { "keyword": "content.subscribeNewsletter", "arg": "kd.sf05@example.com" },
      { "keyword": "content.verifyNewsletterThanks" }
    ]
  }
]
