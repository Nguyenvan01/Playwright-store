[
  {
    "id": "KD-ADC-01",
    "title": "Admin xem danh sách sản phẩm thật rồi mở form thêm (validate trống)",
    "tags": ["@smoke"],
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "admin.openAdminPage", "args": ["/admin/products", "Sản phẩm"] },
      { "keyword": "adminCatalog.verifyColumns", "arg": "@data:admin-catalog/products.json#headers" },
      { "keyword": "adminCatalog.verifyProductCountAtLeast", "arg": 1 },
      { "keyword": "adminCatalog.clickAddProduct" },
      { "keyword": "admin.verifyHeaderTitle", "arg": "Thêm sản phẩm mới" },
      { "keyword": "adminCatalog.verifyProductFormReady", "arg": "Tạo sản phẩm" },
      { "keyword": "adminCatalog.submitProductForm", "note": "form trống -> lỗi phía client, không gửi request" },
      { "keyword": "adminCatalog.verifyProductFormError", "arg": "Vui lòng nhập tên và giá sản phẩm" },
      { "keyword": "common.verifyNoPageErrors" }
    ]
  },
  {
    "id": "KD-ADC-02",
    "title": "Thêm danh mục mới (mock POST) và thấy thẻ mới",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminCatalog.mockCatalogApi", "arg": { "categories": "@data:admin-catalog/fixtures.json#categories" } },
      { "keyword": "common.mockWrite", "args": ["POST", "**/api/admin/categories", "@data:admin-catalog/taxonomy.json#0.create.response"] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/categories", "Danh mục"] },
      { "keyword": "admin.clickButton", "arg": "Thêm danh mục" },
      { "keyword": "admin.verifyModalOpen", "arg": "Thêm danh mục mới" },
      { "keyword": "admin.fillForm", "arg": "@data:admin-catalog/taxonomy.json#0.create.form" },
      { "keyword": "admin.clickButton", "arg": "Lưu" },
      { "keyword": "common.verifyRequest", "args": ["POST", "/admin/categories", "@data:admin-catalog/taxonomy.json#0.create.payload"] },
      { "keyword": "common.verifyToast", "arg": "Đã thêm danh mục mới" },
      { "keyword": "admin.verifyModalClosed", "arg": "Thêm danh mục mới" },
      { "keyword": "adminCatalog.verifyCards", "args": [["Váy E2E", "Áo Thun E2E"]] }
    ]
  },
  {
    "id": "KD-ADC-03",
    "title": "Tìm thương hiệu rồi tắt hoạt động (mock PUT)",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminCatalog.mockCatalogApi", "arg": { "brands": "@data:admin-catalog/fixtures.json#brands" } },
      { "keyword": "common.mockWrite", "args": ["PUT", "**/api/admin/brands/9402", { "success": true }] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/brands", "Thương hiệu"] },
      { "keyword": "admin.searchList", "args": ["Tìm kiếm thương hiệu...", "routine"] },
      { "keyword": "adminCatalog.verifyCards", "args": [["Routine E2E"], ["Canifa E2E", "Kids E2E"]] },
      { "keyword": "adminCatalog.clickCardToggle", "arg": "Routine E2E" },
      { "keyword": "common.verifyRequest", "args": ["PUT", "/admin/brands/9402", { "is_active": false }] },
      { "keyword": "common.verifyToast", "arg": "Đã cập nhật trạng thái" },
      { "keyword": "adminCatalog.verifyCardActive", "args": ["Routine E2E", false] }
    ]
  },
  {
    "id": "KD-ADC-04",
    "title": "Tạo sản phẩm có 2 biến thể (mock POST) rồi về danh sách",
    "requires": ["admin"],
    "steps": [
      { "keyword": "auth.restoreSession", "arg": "admin" },
      { "keyword": "adminCatalog.mockCatalogApi", "arg": "@data:admin-catalog/fixtures.json" },
      { "keyword": "common.mockWrite", "args": ["POST", "**/api/admin/products", { "success": true }] },
      { "keyword": "admin.openAdminPage", "args": ["/admin/products/create", "Thêm sản phẩm mới"] },
      { "keyword": "adminCatalog.verifyProductFormReady", "arg": "Tạo sản phẩm" },
      { "keyword": "admin.fillForm", "arg": { "Tên sản phẩm": "Áo kịch bản E2E", "Giá bán": "150000", "SKU": "KD-ADC", "Danh mục": "Áo Thun E2E" } },
      { "keyword": "adminCatalog.toggleVariantBuilder" },
      { "keyword": "adminCatalog.selectVariantSizes", "arg": ["L"] },
      { "keyword": "adminCatalog.selectVariantColors", "arg": ["Đen", "Xám"] },
      { "keyword": "adminCatalog.verifyGenerateVariantsButton", "args": ["Tạo 2 biến thể", true] },
      { "keyword": "adminCatalog.generateVariants" },
      { "keyword": "adminCatalog.verifyVariantRows", "arg": [
        { "size": "L", "color": "Đen", "sku": "KD-ADC-4-1" },
        { "size": "L", "color": "Xám", "sku": "KD-ADC-4-3" }
      ] },
      { "keyword": "adminCatalog.submitProductForm" },
      { "keyword": "common.verifyRequest", "args": ["POST", "/admin/products", { "name": "Áo kịch bản E2E", "slug": "ao-kich-ban-e2e", "price": 150000, "category_id": 9301 }] },
      { "keyword": "common.verifyToast", "arg": "Tạo sản phẩm thành công." },
      { "keyword": "common.verifyUrl", "arg": "/admin/products" }
    ]
  }
]
