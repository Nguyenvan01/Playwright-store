# Môi trường PRODUCTION trên Vercel. Chạy: npm run test:prod
# Frontend và API cùng domain (vercel.json rewrite /api/* -> serverless function).
BASE_URL=https://dat-hoang-store.vercel.app
API_URL=https://dat-hoang-store.vercel.app/api

# Production: KHÔNG ghi dữ liệu thật. Tạo đơn/đăng ký luôn được mock.
# (Muốn ghi thật phải đặt thêm E2E_ALLOW_WRITE_REMOTE=1 - không khuyến khích.)
E2E_ALLOW_WRITE=0

# Tài khoản test riêng trên production (tạo thủ công, không dùng tài khoản thật của khách).
E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
